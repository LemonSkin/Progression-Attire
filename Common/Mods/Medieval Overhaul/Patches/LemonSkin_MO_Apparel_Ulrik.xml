<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/label</xpath>
    <value>
      <label>chain coif (adorned)</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]/label</xpath>
    <value>
      <label>chainveil helm (adorned)</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="DankPyon_Base_Pants"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedMailShirt"]</xpath>
        <value>
          <costList Operation="AddOrReplace">
            <DankPyon_Linen>50</DankPyon_Linen>
          </costList>
          <statBases Operation="AddOrReplace">
            <WorkToMake>18000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>10</Insulation_Cold>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.15</SlaveSuppressionOffset>
            <PainShockThreshold>0.025</PainShockThreshold>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>9</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Middle</li>
              <li>Shell</li>
            </layers>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedWarriorArmor"]</xpath>
        <value>
          <costList Operation="AddOrReplace">
            <DankPyon_Linen>50</DankPyon_Linen>
          </costList>
          <statBases Operation="AddOrReplace">
            <WorkToMake>32000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>10</Insulation_Cold>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.5</MoveSpeed>
            <PainShockThreshold>0.05</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.15</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>10</Crafting>
            </skillRequirements>
            <researchPrerequisites Operation="AddOrReplace">
              <li>DankPyon_AdornedArmor</li>
              <li>PlateArmor</li>
            </researchPrerequisites>
          </recipeMaker>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Middle</li>
              <li>Shell</li>
            </layers>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedHeavyPlate"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">170</costStuffCount>
          <costList Operation="AddOrReplace">
            <Gold>2</Gold>
            <DankPyon_Linen>50</DankPyon_Linen>
          </costList>
          <statBases Operation="AddOrReplace">
            <WorkToMake>42000</WorkToMake>
            <MaxHitPoints>290</MaxHitPoints>
            <Mass>15</Mass>
            <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>10</Insulation_Cold>
            <EquipDelay>15</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.8</MoveSpeed>
            <PainShockThreshold>0.075</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.15</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Middle</li>
              <li>Shell</li>
            </layers>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
        <value>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>8</Crafting>
            </skillRequirements>
          </recipeMaker>
          <statBases Operation="AddOrReplace">
            <WorkToMake>12000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>5</Insulation_Cold>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <PainShockThreshold>0.025</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>UpperHead</li>
            </bodyPartGroups>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]</xpath>
        <value>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>10</Crafting>
            </skillRequirements>
          </recipeMaker>
          <statBases Operation="AddOrReplace">
            <WorkToMake>17000</WorkToMake>
            <MaxHitPoints>175</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.6</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>5</Insulation_Cold>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-3</ShootingAccuracyPawn>
            <PainShockThreshold>0.05</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_GreatHelm"]</xpath>
        <value>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>12</Crafting>
            </skillRequirements>
          </recipeMaker>
          <costStuffCount Operation="AddOrReplace">80</costStuffCount>

          <statBases Operation="AddOrReplace">
            <WorkToMake>20000</WorkToMake>
            <MaxHitPoints>250</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>5</Insulation_Cold>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-8.0</ShootingAccuracyPawn>
            <PainShockThreshold>0.075</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Overhead</li>
            </layers>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_AdornedArmorBase"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Adorned_HeavyMailCoif" or
          defName="DankPyon_Adorned_FlatTop" or
          defName="DankPyon_Adorned_GreatHelm"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- ######################################### END ########################################### -->
</Patch>

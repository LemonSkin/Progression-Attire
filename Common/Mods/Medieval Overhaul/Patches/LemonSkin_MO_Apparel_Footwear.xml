<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]/label</xpath>
    <value>
      <label>jackboots</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">35</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>1600</WorkToMake>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>0.25</Mass>
            <StuffEffectMultiplierArmor>0.18</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.08</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalPeasant</li>
              <li>MedievalBasic</li>
              <li>MedievalNoble</li>
              <li>MedievalRoyal</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsSplinted"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>6</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsPlate"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>6000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>2.5</Mass>
            <StuffEffectMultiplierArmor>0.45</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>8</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryAdvanced</li>
            </tags>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Footwear_BootsSplinted" or
          defName="DankPyon_Footwear_BootsPlate"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Hauberk"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">60</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>10000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>4</Mass>
            <StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>4</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.1</MoveSpeed>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Heavy_Hauberk"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>15000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>7</Mass>
            <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>7</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Middle</li>
              <li>Shell</li>
            </layers>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_HeraldicHauberkBase"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>15000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>7</Mass>
            <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Middle</li>
              <li>Shell</li>
            </layers>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Apparel_Hauberk" or
          defName="DankPyon_Apparel_Heavy_Hauberk" or
          @Name="DankPyon_HeraldicHauberkBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

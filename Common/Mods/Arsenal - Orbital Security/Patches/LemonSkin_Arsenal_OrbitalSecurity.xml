<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_SecurityArmor" or
          defName="Apparel_OrbitalArmor" or
          defName="Apparel_EVAsuit" or
          defName="Apparel_AstroSuit"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_SealedUndersuit"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_AstroMask"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_SecurityHelmet" or defName="Apparel_OrbitalHelmet"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

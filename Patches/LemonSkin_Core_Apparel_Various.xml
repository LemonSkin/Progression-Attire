<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VAPPE_PeltCoat"]</xpath>
    <match Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="Apparel_Parka"]</xpath>
      <value>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">ComplexClothing</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_Cape"]</xpath>
    <match Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="Apparel_Cape"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="Apparel_Robe"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_TribalA"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_Robe"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_Parka" or
          defName="Apparel_Pants" or
          defName="Apparel_BasicShirt" or
          defName="Apparel_CollarShirt" or
          defName="Apparel_Duster" or
          defName="Apparel_Jacket"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_PlateArmor"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_FlakVest" or
          defName="Apparel_FlakPants" or
          defName="Apparel_FlakJacket"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          @Name="ApparelArmorPowerBase" or
          @Name="ApparelArmorReconBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ######################################### -->
</Patch>

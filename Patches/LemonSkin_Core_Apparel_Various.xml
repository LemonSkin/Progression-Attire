<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_TribalA"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_Robe"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[defName="Apparel_Parka" or
          defName="Apparel_Pants" or
          defName="Apparel_BasicShirt" or
          defName="Apparel_CollarShirt" or
          defName="Apparel_Duster" or
          defName="Apparel_Jacket"]/thingCategories
        </xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_IndustrialApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_PlateArmor"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[defName="Apparel_FlakVest" or
          defName="Apparel_FlakPants" or
          defName="Apparel_FlakJacket"]/thingCategories
        </xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[@Name="ApparelArmorPowerBase" or
          @Name="ApparelArmorReconBase"]/thingCategories
        </xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VAPPE_PeltCoat"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="Apparel_Parka"]</xpath>
      <value>
        <techLevel Operation="AddOrReplace">Industrial</techLevel>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">ComplexClothing</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="Apparel_PlateArmor"]</xpath>
        <value>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">10</Crafting>
            </skillRequirements>
          </recipeMaker>
          <costStuffCount Operation="AddOrReplace">200</costStuffCount>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_Cape"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_Cape"]/recipeMaker</xpath>
      <value>
        <researchPrerequisite>LemonSkin_RusticClothing</researchPrerequisite>
      </value>
    </match>
  </Operation>
  <!-- Apparel_Robe -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Apparel_Robe"]/recipeMaker</xpath>
    <value>
      <researchPrerequisite>LemonSkin_RusticClothing</researchPrerequisite>
    </value>
  </Operation>
</Patch>

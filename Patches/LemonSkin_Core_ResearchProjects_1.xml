<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ResearchProjectDef[defName="ComplexClothing"]</xpath>
    <value>
      <techLevel>Industrial</techLevel>
      <prerequisites Operation="AddOrReplace">
        <li>LemonSkin_RusticClothing</li>
      </prerequisites>
      <researchViewX>1.0</researchViewX>
    </value>
  </Operation>

  <Operation Class="ProgressionAttire.PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="DankPyon_ChainArmor"]</xpath>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ResearchProjectDef[defName="PlateArmor"]</xpath>
        <value>
          <prerequisites Operation="AddOrReplace">
            <li>DankPyon_ChainArmor</li>
            <li>Smithing</li>
          </prerequisites>
        </value>
      </Operation>
    </caseTrue>
    <caseFalse>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ResearchProjectDef[defName="PlateArmor"]</xpath>
        <value>
          <prerequisites Operation="AddOrReplace">
            <li>LemonSkin_RusticClothing</li>
            <li>Smithing</li>
          </prerequisites>
        </value>
      </Operation>
    </caseFalse>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_TribalHeaddress"]</xpath>
    <match Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="Apparel_TribalHeaddress"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_TribalHeaddress</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_WarMasks"]</xpath>
    <match Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="Apparel_WarMask"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_WarMasks</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="Apparel_HatHood"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="Apparel_SimpleHelmet"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="SafeRemove" />
        <researchPrerequisites Operation="AddOrReplace">
          <li>ComplexClothing</li>
          <li>Smithing</li>
        </researchPrerequisites>
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_CowboyHat"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.14</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.4</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.05</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_BowlerHat"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>1800</WorkToMake>
            <Mass>0.14</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.30</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.1</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="PatchOperationFindMod">
        <mods>
          <li>Ideology</li>
        </mods>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="Apparel_HatHood"]</xpath>
          <value>
            <equippedStatOffsets Operation="AddOrReplace">
              <ConversionPower>0.05</ConversionPower>
            </equippedStatOffsets>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          @Name="HatBase" or
          @Name="HatMakeableBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="ArmorHelmetMakeableBase"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          @Name="ApparelArmorHelmetPowerBase" or
          @Name="ApparelArmorHelmetReconBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_TribalHeaddress" or
          defName="Apparel_WarMask" or
          defName="Apparel_WarVeil"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_HatHood"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

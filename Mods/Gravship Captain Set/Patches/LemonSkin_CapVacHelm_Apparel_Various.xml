<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GravshipCaptainVacsuit"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="PrestigeGravshipCaptainVacsuit"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PrestigeGravshipCaptainVacsuit"]/thingCategories</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

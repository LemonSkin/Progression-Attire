<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="GravshipCaptainVacsuitHelmet"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="PrestigeGravshipCaptainVacsuitHelmet"]</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PrestigeGravshipCaptainVacsuitHelmet"]</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>LemonSkin_SpacerArmorHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

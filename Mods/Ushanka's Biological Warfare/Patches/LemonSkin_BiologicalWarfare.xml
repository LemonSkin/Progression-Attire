<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="USH_RespiratorMask"]</xpath>
    <value>
      <techLevel Operation="AddOrReplace">Industrial</techLevel>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="USH_RespiratorMask"]</xpath>
        <value>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Overhead</li>
            </layers>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

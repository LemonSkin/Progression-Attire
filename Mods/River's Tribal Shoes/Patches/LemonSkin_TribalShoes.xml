<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_RiverTribalShoes"]</xpath>
    <match Class="ProgressionAttire.PatchOperationMerge">
      <xpath>
        Defs/ThingDef[
        defName="River_Tribal_sandals" or
        defName="River_Tribal_moccasins"
        ]
      </xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_RiverTribalShoes</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_RiverTribalMukluks"]</xpath>
    <match Class="ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="River_Tribal_mukluks"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_RiverTribalMukluks</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="River_Tribal_sandals" or
          defName="River_Tribal_moccasins" or
          defName="River_Tribal_mukluks"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->

  <!-- Bugfix for MO's removed tailor bench-->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="River_Tribal_sandals" or
      defName="River_Tribal_moccasins" or
      defName="River_Tribal_mukluks"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <recipeUsers Operation="AddOrReplace">
          <li>ElectricTailoringBench</li>
          <li>HandTailoringBench</li>
          <li>CraftingSpot</li>
        </recipeUsers>
      </recipeMaker>
    </value>
  </Operation>
</Patch>

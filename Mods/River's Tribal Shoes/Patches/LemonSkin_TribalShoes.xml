<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[defName="River_Tribal_sandals" or
          defName="River_Tribal_moccasins" or
          defName="River_Tribal_mukluks"]/thingCategories
        </xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_RiverTribalShoes"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="River_Tribal_sandals" or defName="River_Tribal_moccasins"]</xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_RiverTribalShoes</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_RiverTribalMukluks"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="River_Tribal_mukluks"]</xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_RiverTribalMukluks</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CAT_Apparel_CrossBikiniTop"]/label</xpath>
    <value>
      <label>cross bikini top</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CAT_Apparel_CrossBikiniBottom"]/label</xpath>
    <value>
      <label>cross bikini bottom</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CAT_MagusHoodOpen"]/label</xpath>
    <value>
      <label>magus hood (open)</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CAT_PrestigeStellicKnightHelmetOpen"]/label</xpath>
    <value>
      <label>prestige stellic knight helmet (open)</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="CAT_Apparel_CrossBikiniTop" or
      defName="CAT_Apparel_CrossBikiniBottom" or
      defName="CAT_Apparel_ImperialDancerTop" or
      defName="CAT_Apparel_ImperialDancerBottom" or
      defName="CAT_Apparel_LuxuryLingerie" or
      defName="CAT_Apparel_LuxuryPanty"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">Ferny_VanityTable</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="CAT_MagusHood" or
          defName="CAT_MagusHoodOpen" or
          defName="CAT_PrestigeStellicKnightHelmet" or
          defName="CAT_PrestigeStellicKnightHelmetOpen"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="CAT_PrestigeStellicKnightArmor"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_PonpecoPajamaA"]/label</xpath>
    <value>
      <label>loose pajamas</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_PonpecoPajamaB"]/label</xpath>
    <value>
      <label>classic pajamas</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_PonpecoPajamaParka"]/label</xpath>
    <value>
      <label>fluffy pajamas</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_PonpecoPajamaSlippers"]/label</xpath>
    <value>
      <label>fluffy slippers</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PonHotMilk"]/label</xpath>
    <value>
      <label>hot milk</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      @Name="ApparelPonpecoPajamaBase" or
      defName="Apparel_PonpecoPajamaParka" or
      defName="Apparel_PonpecoPajamaSlippers"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">Ferny_VanityTable</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

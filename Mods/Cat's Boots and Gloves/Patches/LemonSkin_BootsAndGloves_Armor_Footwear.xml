<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="CAT_Footwear_EltexBoots"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="CAT_Footwear_ReconBoots" or
          defName="CAT_Footwear_HeavyMarineBoots"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Footwear_EnsignBoots"]</xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Footwear_EnsignBoots"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Footwear_CrusaderBoots"]</xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Footwear_CrusaderBoots"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="CAT_Footwear_FlakBoots" or
          defName="CAT_Footwear_RiotBoots"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Footwear_VacsuitBoots"]</xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Footwear_VacsuitBoots"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

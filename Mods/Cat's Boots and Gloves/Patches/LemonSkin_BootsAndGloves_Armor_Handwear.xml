<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_EltexGloves"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="CAT_Handwear_ReconGloves" or
          defName="CAT_Handwear_HeavyMarineGloves"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_EnsignGloves"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Handwear_EnsignGloves"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_CrusaderGloves"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Handwear_CrusaderGloves"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="CAT_Handwear_FlakGloves" or
          defName="CAT_Handwear_RiotGloves"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_VacsuitGloves"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="CAT_Handwear_VacsuitGloves"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_FlakGloves"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_RiotGloves"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_IndustrialArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="CAT_Handwear_VacsuitGloves"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="CAT_Handwear_VacsuitGloves"]/thingCategories</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

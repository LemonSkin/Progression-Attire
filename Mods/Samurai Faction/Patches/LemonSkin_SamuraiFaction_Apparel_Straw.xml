<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawHat"]/label</xpath>
    <value>
      <label>ajirogasa</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]/label</xpath>
    <value>
      <label>mino</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_StrawHat"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.07</Mass>
            <Flammability>1.5</Flammability>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.025</ArmorRating_Blunt>
            <ArmorRating_Heat>-0.1</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>8</Insulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]</xpath>
        <value>
          <costList Operation="AddOrReplace">
            <Hay>80</Hay>
          </costList>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>1</Mass>
            <Flammability>1.5</Flammability>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.025</ArmorRating_Blunt>
            <ArmorRating_Heat>-0.1</ArmorRating_Heat>
            <Insulation_Cold>10</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <HuntingStealth>0.05</HuntingStealth>
          </equippedStatOffsets>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Shell</li>
            </layers>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_StrawHat"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_Headband"]/label</xpath>
    <value>
      <label>hachimaki</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="TSFApparel_Headband"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">TSF_Bushido_Code</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="TSFApparel_DaimyoHelmet"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisites Operation="AddOrReplace">
          <li>TSF_SamuraiArmor</li>
          <li MayRequire="Ludeon.Rimworld.Royalty">NobleApparel</li>
        </researchPrerequisites>
        <researchPrerequisite Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_Headband"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">15</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1200</WorkToMake>
            <Mass>0.07</Mass>
            <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MentalBreakThreshold>-0.05</MentalBreakThreshold>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_AshigaruHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">60</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>11200</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.45</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-2</ShootingAccuracyPawn>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">6</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_SamuraiHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>12000</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
            <PainShockThreshold>0.10</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">7</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel Operation="Safe">
            <bodyPartGroups Operation="AddOrReplace">
              <li>FullHead</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_DaimyoHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>19200</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
            <PainShockThreshold>0.10</PainShockThreshold>
            <SocialImpact>0.3</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">9</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel Operation="Safe">
            <bodyPartGroups Operation="AddOrReplace">
              <li>FullHead</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="TSFApparel_Headband" or
          defName="TSFApparel_NinjaMask"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="TSFApparel_AshigaruHelmet" or
          defName="TSFApparel_SamuraiHelmet" or
          defName="TSFApparel_DaimyoHelmet"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_OniHelmet"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_HaoriJacket"]/label</xpath>
    <value>
      <label>haori</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="TSFApparel_DaimyoArmor"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="SafeRemove" />
        <researchPrerequisites Operation="AddOrReplace">
          <li>TSF_SamuraiArmor</li>
          <li MayRequire="Ludeon.Rimworld.Royalty">NobleApparel</li>
        </researchPrerequisites>
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_Gi"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>3200</WorkToMake>
            <Mass>0.75</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.42</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.3</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_NinjaTools"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>3000</WorkToMake>
            <Mass>1.25</Mass>
            <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.75</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_Kimono"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">80</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>3200</WorkToMake>
            <Mass>0.8</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.62</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_Yukata"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">80</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>3200</WorkToMake>
            <Mass>0.7</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.62</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_HaoriJacket"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>5000</WorkToMake>
            <Mass>1.2</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.6</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_AshigaruArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">140</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.45</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <MeleeDodgeChance>5</MeleeDodgeChance>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>6</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>Torso</li>
              <li>Neck</li>
              <li>Shoulders</li>
              <li>Arms</li>
              <li>Legs</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_SamuraiArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">180</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>230</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>15</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MeleeDodgeChance>5</MeleeDodgeChance>
            <MoveSpeed>-0.4</MoveSpeed>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>8</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_DaimyoArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">180</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>29200</WorkToMake>
            <MaxHitPoints>230</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>15</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MeleeDodgeChance>5</MeleeDodgeChance>
            <MoveSpeed>-0.4</MoveSpeed>
            <SocialImpact>0.2</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>10</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="TSFApparel_Gi" or
          defName="TSFApparel_NinjaTools" or
          defName="TSFApparel_Kimono" or
          defName="TSFApparel_Yukata" or
          defName="TSFApparel_HaoriJacket"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="TSFApparel_AshigaruArmor" or
          defName="TSFApparel_SamuraiArmor" or
          defName="TSFApparel_DaimyoArmor"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TSFApparel_OniArmor"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_SashimonoBanner"]</xpath>
        <value>
          <equippedStatOffsets Operation="AddOrReplace">
            <PainShockThreshold>0.1</PainShockThreshold>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="TSFApparel_SmokeBomb"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>1200</WorkToMake>
            <Mass>1</Mass>
            <PackRadius>4</PackRadius>
            <EquipDelay>1</EquipDelay>
            <MaxHitPoints>25</MaxHitPoints>
          </statBases>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="DankPyon_Coal"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="TSFApparel_SmokeBomb"]/costList</xpath>
          <value>
            <costList>
              <Steel>5</Steel>
              <DankPyon_Coal>5</DankPyon_Coal>
            </costList>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="TSFApparel_SashimonoBanner" or
          defName="TSFApparel_SmokeBomb"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

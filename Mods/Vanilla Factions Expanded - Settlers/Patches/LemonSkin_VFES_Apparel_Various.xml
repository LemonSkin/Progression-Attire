<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Vest"]/label</xpath>
    <value>
      <label>cowboy vest</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ######################################### -->

  <!-- ######################################### REBALANCES ######################################### -->

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="Apparel_Vest" or
          defName="Apparel_GreatDress"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>ApparelNoble</li>
            <li>LemonSkin_IndustrialApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ######################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBSFE_Faecrown"]/label</xpath>
    <value>
      <label>leaf crown</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBSFE_Faerose"]/label</xpath>
    <value>
      <label>rose</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBSFE_Faerose"]/description</xpath>
    <value>
      <description>A romantic rose held between the teeth. It strengthens the wearer's social impact and connection with nature, but offers little else.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBSFE_Faecap"]/label</xpath>
    <value>
      <label>leaf emblem cap</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RBSFE_Faescarf"]/label</xpath>
    <value>
      <label>leaf scarf</label>
    </value>
  </Operation>

  <!-- Research Changes -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_Leafwear"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>
        Defs/ThingDef[@Name="FaeApparelBase" or
        defName="RBSFE_Faecrown" or
        defName="RBSFE_Faerose" or
        defName="RBSFE_Faecap" or
        defName="RBSFE_Faescarf"]
      </xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_Leafwear</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_Leafwear"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>
        Defs/ThingDef[defName="RBSFE_Faemail" or
        defName="RBSF_Faehelm"]
      </xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="SafeRemove">RBSFE_FaeCraftables</researchPrerequisite>
          <researchPrerequisites Operation="SafeAdd">
            <li>LemonSkin_Leafwear</li>
            <li>Smithing</li>
          </researchPrerequisites>
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- Stat Rebalances -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faegarms"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.4</Mass>
            <Insulation_Cold>8.8</Insulation_Cold>
            <Insulation_Heat>8.8</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.10</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_KidFaegarms"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>60</MaxHitPoints>
            <WorkToMake>1400</WorkToMake>
            <Mass>0.4</Mass>
            <Insulation_Cold>8.8</Insulation_Cold>
            <Insulation_Heat>8.8</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.10</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faepron"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>2</Insulation_Cold>
            <Insulation_Heat>2</Insulation_Heat>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>0.5</Mass>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.10</RBSF_NatureConnectionOffset>
            <PlantWorkSpeed>0.10</PlantWorkSpeed>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faecloak"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>8000</WorkToMake>
            <Mass>1</Mass>
            <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
            <ArmorRating_Heat>-0.05</ArmorRating_Heat>
            <Insulation_Cold>14.4</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.20</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faeleaf"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <MaxHitPoints>69</MaxHitPoints>
            <WorkToMake>750</WorkToMake>
            <Mass>0.1</Mass>
            <EquipDelay>0.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.10</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faemail"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">140</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.30</RBSF_NatureConnectionOffset>
            <MoveSpeed>-0.20</MoveSpeed>
            <Beauty>5</Beauty>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">6</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faecrown"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <WorkToMake>800</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>
            <Mass>0.05</Mass>
            <EquipDelay>0.8</EquipDelay>
            <Flammability>1.5</Flammability>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <Beauty>1</Beauty>
            <RBSF_NatureConnectionOffset>0.05</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faerose"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <WorkToMake>1500</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>
            <Mass>0.05</Mass>
            <EquipDelay>0.8</EquipDelay>
            <Flammability>1.5</Flammability>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.05</RBSF_NatureConnectionOffset>
            <SocialImpact>0.05</SocialImpact>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faecap"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <WorkToMake>2100</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>
            <Mass>0.07</Mass>
            <EquipDelay>0.8</EquipDelay>
            <Flammability>1.5</Flammability>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.10</RBSF_NatureConnectionOffset>
            <PsychicSensitivity>0.05</PsychicSensitivity>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSFE_Faescarf"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>5</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <WorkToMake>1200</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>
            <Mass>0.09</Mass>
            <EquipDelay>0.8</EquipDelay>
            <Flammability>1.5</Flammability>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ToxicEnvironmentResistance>0.1</ToxicEnvironmentResistance>
            <RBSF_NatureConnectionOffset>0.05</RBSF_NatureConnectionOffset>
          </equippedStatOffsets>
          <apparel Operation="Safe">
            <bodyPartGroups Operation="AddOrReplace">
              <li>Neck</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBSF_Faehelm"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>11200</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Flammability>1</Flammability>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RBSF_NatureConnectionOffset>0.2</RBSF_NatureConnectionOffset>
            <Beauty>5</Beauty>
            <ShootingAccuracyPawn>-2</ShootingAccuracyPawn>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <recipeUsers Operation="SafeAdd" Inherit="False">
              <li>ElectricSmithy</li>
              <li>FueledSmithy</li>
              <li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Anvil</li>
            </recipeUsers>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- Categories -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[@Name="FaeApparelBase"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RBSFE_KidFaegarms"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_KidApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RBSFE_Faemail"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[defName="RBSFE_Faecrown" or
          defName="RBSFE_Faerose" or
          defName="RBSFE_Faecap" or
          defName="RBSFE_Faescarf"]/thingCategories
        </xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RBSF_Faehelm"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_BodyStrap"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_PrisonerApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_Burka"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_TortureCrown"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_Blindfold"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- Apparel_BodyStrap -->

  <!-- Apparel_Burka -->

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>
      Defs/ThingDef[defName="Apparel_Burka" or
      defName="Apparel_BodyStrap"]
    </xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>
</Patch>

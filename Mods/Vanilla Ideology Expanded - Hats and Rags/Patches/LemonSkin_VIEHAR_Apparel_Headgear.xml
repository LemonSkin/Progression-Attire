            <ConversionPower>0.05</ConversionPower>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_BrimlessHat"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">25</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.07</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>

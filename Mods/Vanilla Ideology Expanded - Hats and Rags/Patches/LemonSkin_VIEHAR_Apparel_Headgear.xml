  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="VIEHAR_Apparel_Beads" or
          defName="VIEHAR_Apparel_DeerSkull"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="VIEHAR_Apparel_BishopHat" or
          defName="VIEHAR_Apparel_BrimlessHat" or
          defName="VIEHAR_Apparel_Fez" or
          defName="VIEHAR_Apparel_Headbag" or
          defName="VIEHAR_Apparel_Headscarf" or
          defName="VIEHAR_Apparel_Skullcap" or
          defName="VIEHAR_Apparel_SpikedSkullcap" or
          defName="VIEHAR_Apparel_WideHat"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_HorseMask"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_PrisonerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->

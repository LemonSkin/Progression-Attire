<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_BishopHat"]/label</xpath>
    <value>
      <label>mitre</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_BrimlessHat"]/label</xpath>
    <value>
      <label>kufi</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_BishopHat"]/techLevel</xpath>
    <value>
      <techLevel>Medieval</techLevel>
    </value>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="VIEHAR_Apparel_BishopHat" or
      defName="VIEHAR_Apparel_BrimlessHat" or
      defName="VIEHAR_Apparel_Fez" or
      defName="VIEHAR_Apparel_Headbag" or
      defName="VIEHAR_Apparel_Headscarf" or
      defName="VIEHAR_Apparel_Skullcap" or
      defName="VIEHAR_Apparel_SpikedSkullcap" or
      defName="VIEHAR_Apparel_WideHat"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="VIEHAR_Apparel_CommisarHat" or
      defName="VIEHAR_Apparel_HorseMask" or
      defName="VIEHAR_Apparel_MilitaryCap"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">ComplexClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_Beads"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>160</MaxHitPoints>
            <WorkToMake>2600</WorkToMake>
            <Mass>0.5</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <CertaintyLossFactor>-0.05</CertaintyLossFactor>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VIEHAR_Apparel_BishopHat"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>4000</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>
      Defs/ThingDef[@Name="BMT_Apparel_DinoHatCarni_Base" or
      defName="BMT_Apparel_MascotOutfit"]
    </xpath>
    <value>
      <recipeMaker Operation="AddOrReplace">
        <researchPrerequisite>Ferny_CostumingTable</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->

  <!-- ######################################### CATEGORIES ######################################### -->

  <!-- ######################################### END ######################################### -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@Name="BMT_PlushiesSculptureBase"]/recipeMaker</xpath>
    <value>
      <researchPrerequisites>
        <li>BMT_Paleontology</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>

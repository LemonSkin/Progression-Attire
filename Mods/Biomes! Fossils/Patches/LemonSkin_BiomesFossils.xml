    <xpath>
      Defs/ThingDef[
      @Name="BMT_Apparel_DinoHatCarni_Base" or
      defName="BMT_Apparel_MascotOutfit"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">Ferny_CostumingTable</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="BMT_PlushiesSculptureBase"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="SafeRemove" />
        <researchPrerequisites>
          <li Operation="SafeAdd">BMT_Paleontology</li>
        </researchPrerequisites>
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_PackControl"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerUtility</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_PackBandwidth"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerUtility</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_PackTox"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_IndustrialUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

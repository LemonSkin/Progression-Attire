<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>
            Defs/ThingDef[
            defName="Apparel_AirwireHeadset" or
            defName="Apparel_ArrayHeadset" or
            defName="Apparel_IntegratorHeadset"
            ]
          </xpath>
          <value>
            <apparel>
              <layers Operation="AddOrReplace">
                <li>DankPyon_InnerHelmet</li>
              </layers>
            </apparel>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_AirwireHeadset" or
          defName="Apparel_ArrayHeadset" or
          defName="Apparel_IntegratorHeadset"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

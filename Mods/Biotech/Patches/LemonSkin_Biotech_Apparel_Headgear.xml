<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_AirwireHeadset"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_ArrayHeadset"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyApparelLayers</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_AirwireHeadset"]/apparel/layers</xpath>
          <value>
            <layers>
              <li>DankPyon_InnerHelmet</li>
            </layers>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_ArrayHeadset"]/apparel/layers</xpath>
          <value>
            <layers>
              <li>DankPyon_InnerHelmet</li>
            </layers>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]/apparel</xpath>
          <value>
            <layers Inherit="False">
              <li>DankPyon_InnerHelmet</li>
            </layers>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

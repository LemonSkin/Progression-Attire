<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Headgear_ZweihanderHelmRoxmont"]/label</xpath>
    <value>
      <label>zweihander helm (Roxmont)</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Headgear_HeraldicGreatHelmRoxmont"]/label</xpath>
    <value>
      <label>heraldic great helm (Roxmont)</label>
    </value>
  </Operation>
  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Headgear_HeraldicGreatHelmRoxmont"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>10</Insulation_Cold>
          </statBases>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>9</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

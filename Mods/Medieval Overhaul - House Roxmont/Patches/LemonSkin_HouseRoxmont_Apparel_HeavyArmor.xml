<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Zweihanders_Cuirass_Roxmont"]/label</xpath>
    <value>
      <label>zweihander cuirass (Roxmont)</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate_Roxmont"]/label</xpath>
    <value>
      <label>full plate (Roxmont)</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Zweihanders_Cuirass_Roxmont"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisites Operation="AddOrReplace">
          <li>PlateArmor</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">NobleApparel</li>
        </researchPrerequisites>
        <researchPrerequisite Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate_Roxmont"]/techLevel</xpath>
    <value>
      <techLevel>Medieval</techLevel>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Zweihanders_Cuirass_Roxmont"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">120</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>23600</WorkToMake>
            <MaxHitPoints>250</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.78</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.4</MoveSpeed>
            <SocialImpact>0.1</SocialImpact>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">10</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate_Roxmont"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">150</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>25400</WorkToMake>
            <MaxHitPoints>290</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>20</Insulation_Cold>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.7</MoveSpeed>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">10</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="DankPyon_Apparel_Zweihanders_Cuirass_Roxmont"
          or defName="DankPyon_Apparel_FullPlate_Roxmont"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

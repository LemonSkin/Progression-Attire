<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bandagewraps_Bodywrap"]/label</xpath>
    <value>
      <label>body bandage</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bandagewraps_BodywrapA"]/label</xpath>
    <value>
      <label>sterile body bandage</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandage"]/label</xpath>
    <value>
      <label>head bandage</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandageA"]/label</xpath>
    <value>
      <label>sterile head bandage</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VAE_SterileAttire"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ResearchProjectDef[defName="VAE_SterileAttire"]</xpath>
      <value>
        <prerequisites>
          <li>Ferny_Bandages</li>
        </prerequisites>
      </value>
    </match>
  </Operation>

  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="Bandagewraps_Bodywrap" or
      defName="Bandagewraps_HeadBandage"
      ]
    </xpath>
    <value>
      <techLevel>Neolithic</techLevel>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">Ferny_Bandages</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VAE_SterileAttire"]</xpath>
    <match Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>
        Defs/ThingDef[
        defName="Bandagewraps_BodywrapA" or
        defName="Bandagewraps_HeadBandageA"
        ]
      </xpath>
      <value>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">VAE_SterileAttire</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
    <nomatch Class="ferny.ProgressionAttire.PatchOperationMerge">
      <xpath>
        Defs/ThingDef[
        defName="Bandagewraps_BodywrapA" or
        defName="Bandagewraps_HeadBandageA"
        ]
      </xpath>
      <value>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">Ferny_Bandages</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </nomatch>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_Bodywrap"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>1600</WorkToMake>
            <Mass>0.2</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <InjuryHealingFactor>0.07</InjuryHealingFactor>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_BodywrapA"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>1600</WorkToMake>
            <Mass>0.2</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ImmunityGainSpeed>0.07</ImmunityGainSpeed>
            <InjuryHealingFactor>0.07</InjuryHealingFactor>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandage"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>30</MaxHitPoints>
            <WorkToMake>1300</WorkToMake>
            <Mass>0.05</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <InjuryHealingFactor>0.03</InjuryHealingFactor>
            <ShootingAccuracyPawn>-8</ShootingAccuracyPawn>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandageA"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>30</MaxHitPoints>
            <WorkToMake>1300</WorkToMake>
            <Mass>0.05</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <InjuryHealingFactor>0.03</InjuryHealingFactor>
            <ImmunityGainSpeed>.03</ImmunityGainSpeed>
            <ShootingAccuracyPawn>-8</ShootingAccuracyPawn>
          </equippedStatOffsets>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_Bodywrap"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_BodywrapA"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandage"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Bandagewraps_HeadBandageA"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="AT_AmorphousDress"]/label</xpath>
    <value>
      <label>amorphous dress</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="AT_AmorphousDress" or
      defName="AT_Pileum"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">Ferny_VanityTable</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      defName="TWRL_Apparel_RainbowCatcherArmor" or
      defName="TWRL_Apparel_RainbowCatcherHelmet"
      ]
    </xpath>
    <value>
      <techLevel Operation="AddOrReplace">Spacer</techLevel>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TWRL_Apparel_RainbowCatcherArmor"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TWRL_Apparel_RainbowCatcherHelmet"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

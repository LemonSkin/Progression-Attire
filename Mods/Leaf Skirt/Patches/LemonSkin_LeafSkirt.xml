<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_Leafwear"]</xpath>
    <match Class="ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/RecipeDef[defName="Make_Leaf_Skirt"]</xpath>
      <value>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_Leafwear</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </value>
    </match>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="LeafSkirt"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>750</WorkToMake>
            <Mass>0.1</Mass>
            <EquipDelay>0.5</EquipDelay>
            <Flammability>1.5</Flammability>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="LeafSkirt"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

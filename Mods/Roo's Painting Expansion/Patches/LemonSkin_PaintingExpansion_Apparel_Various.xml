<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="RBPApparel_Smock"]</xpath>
    <value>
      <label Operation="AddOrReplace">artist's smock</label>
      <techLevel Operation="AddOrReplace">Medieval</techLevel>
    </value>
  </Operation>

  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="RBPApparel_CreativeBeret"]</xpath>
    <value>
      <label Operation="AddOrReplace">artist's beret</label>
      <techLevel Operation="AddOrReplace">Medieval</techLevel>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="RBPApparel_Smock"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">120</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>4300</WorkToMake>
            <Mass>0.8</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.46</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.3</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <GeneralLaborSpeed>0.05</GeneralLaborSpeed>
          </equippedStatOffsets>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>OnSkin</li>
              <li>Middle</li>
            </layers>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="RBPApparel_CreativeBeret"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">35</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>900</WorkToMake>
            <Mass>0.1</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.07</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="SafeRemove" />
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="RBPApparel_Smock"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
            <!-- <li>LemonSkin_Workwear</li> -->
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="RBPApparel_CreativeBeret"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
            <!-- <li>LemonSkin_WorkwearHeadgear</li> -->
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
  <!-- Bugfix for config error on these buildings -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="RBPGalleryBarrier" or defName="RBPArtCabinet"]/passability</xpath>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DV_Headgear_AvaloiGlasses"]/recipeMaker</xpath>
    <value>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DV_Headgear_AvaloiGlasses"]</xpath>
        <value>
          <stuffCategories Operation="AddOrReplace">
            <li>Metallic</li>
          </stuffCategories>
          <costStuffCount Operation="AddOrReplace">15</costStuffCount>
          <costList Operation="SafeRemove" />
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1500</WorkToMake>
            <Mass>0.02</Mass>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
            <ArmorRating_Heat>0.04</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>0.4</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DV_Headgear_AvaloiGlasses"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_IndustrialHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

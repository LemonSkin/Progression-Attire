<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>
      Defs/ThingDef[
      @Name="TACTICOOL_GlassesBase" or
      @Name="TACTICOOL_FaceBandanaBase" or
      @Name="TACTICOOL_BalaclavaBase" or
      defName="TACTICOOL_MeshCap"
      ]
    </xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">ComplexClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="TACTICOOL_FaceBandanaBase"]/techLevel</xpath>
    <value>
      <techLevel>Industrial</techLevel>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="TACTICOOL_GlassesBase"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">10</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1000</WorkToMake>
            <Mass>0.01</Mass>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
            <ArmorRating_Heat>0.04</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>0.4</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TACTICOOL_Aviators"]</xpath>
        <value>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.05</SocialImpact>
            <NegotiationAbility>0.05</NegotiationAbility>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="TACTICOOL_BallisticGlasses" or
          defName="TACTICOOL_BallisticGlassesNeon"
          ]
        </xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1000</WorkToMake>
            <Mass>0.01</Mass>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
            <ArmorRating_Heat>0.40</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>0.4</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="TACTICOOL_FaceBandanaBase"]</xpath>
        <value>
          <stuffCategories Operation="AddOrReplace">
            <li>Fabric</li>
          </stuffCategories>
          <statBases Operation="AddOrReplace">
            <WorkToMake>1200</WorkToMake>
            <MaxHitPoints>80</MaxHitPoints>
            <Mass>0.05</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.05</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.05</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ToxicEnvironmentResistance>0.45</ToxicEnvironmentResistance>
            <PainShockThreshold>0.10</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="TACTICOOL_BalaclavaBase"]</xpath>
        <value>
          <stuffCategories Operation="AddOrReplace">
            <li>Fabric</li>
          </stuffCategories>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.07</Mass>
            <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ToxicEnvironmentResistance>0.45</ToxicEnvironmentResistance>
            <MentalBreakThreshold>-0.05</MentalBreakThreshold>
          </equippedStatOffsets>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>FullHead</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="TACTICOOL_MeshCap"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">20</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1200</WorkToMake>
            <Mass>0.07</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          @Name="TACTICOOL_GlassesBase" or
          @Name="TACTICOOL_FaceBandanaBase" or
          @Name="TACTICOOL_BalaclavaBase" or
          defName="TACTICOOL_MeshCap"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[defName="DV_Apparel_HunterVisage"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">ReconArmor</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DV_Apparel_HunterVisage"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

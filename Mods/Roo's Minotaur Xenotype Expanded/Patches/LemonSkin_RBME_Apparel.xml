<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- RBME_Chiton -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="RBME_Chiton"]</xpath>
    <value>
      <techLevel Operation="AddOrReplace">Neolithic</techLevel>
      <recipeMaker Operation="Safe">
        <recipeUsers Operation="Safe">
          <li Operation="AddOrReplace">CraftingSpot</li>
        </recipeUsers>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="VFEC_Togas"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="RBME_Chiton"]</xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">VFEC_Togas</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- RBME_RoyalHellenicHelmet -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="RBME_RoyalHellenicHelmet"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="SafeRemove" />
        <researchPrerequisites Operation="AddOrReplace">
          <li>PlateArmor</li>
          <li MayRequire="Ludeon.RimWorld.Royalty">RoyalApparel</li>
        </researchPrerequisites>
      </recipeMaker>
    </value>
  </Operation>

  <!-- RBME_Cowbell -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="RBME_Cowbell"]</xpath>
    <value>
      <techLevel Operation="AddOrReplace">Neolithic</techLevel>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RBME_Cowbell</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
        <recipeUsers Operation="Safe">
          <li Operation="AddOrReplace">CraftingSpot</li>
        </recipeUsers>
      </recipeMaker>
    </value>
  </Operation>

  <!-- Stat Rebalances -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBME_Chiton"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">50</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>200</WorkToMake>
            <Mass>0.4</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.35</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.75</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBME_HellenicHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>14600</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.72</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-6</ShootingAccuracyPawn>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBME_RoyalHellenicHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>14600</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.72</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-6</ShootingAccuracyPawn>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
            <SocialImpact>0.1</SocialImpact>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="RBME_Cowbell"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">15</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.14</Mass>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- Categories -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="RBME_Chiton"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="RBME_Panoply"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_UltraArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>
          Defs/ThingDef[defName="RBME_HellenicHelmet" or
          defName="RBME_RoyalHellenicHelmet"]
        </xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RBME_Cowbell"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_NeolithicHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

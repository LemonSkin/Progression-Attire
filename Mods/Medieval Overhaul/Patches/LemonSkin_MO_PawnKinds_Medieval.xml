<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[defName="DankPyon_Medieval_Peasant"]</xpath>
        <value>
          <apparelAllowHeadgearChance>0.6</apparelAllowHeadgearChance>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalPeasant</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[defName="DankPyon_Medieval_Merchant"]</xpath>
        <value>
          <apparelAllowHeadgearChance>0.8</apparelAllowHeadgearChance>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalPeasant</li>
            <li>MedievalBasic</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[defName="DankPyon_Medieval_Mercenary"]</xpath>
        <value>
          <apparelAllowHeadgearChance>0.8</apparelAllowHeadgearChance>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Apparel_Hauberk</li>
          </apparelRequired>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalPeasant</li>
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[defName="DankPyon_Medieval_MercenaryHeavy"]</xpath>

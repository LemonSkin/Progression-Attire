        <value>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
            <li>MedievalMilitaryAdvanced</li>
          </apparelTags>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Apparel_Zweihanders_Cuirass</li>
            <li>DankPyon_Footwear_BootsPlate</li>
            <li>DankPyon_Handwear_GlovesPlate</li>
            <li>DankPyon_Apparel_ChaussesPlate</li>
          </apparelRequired>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_Zweihander"]</xpath>
        <value>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>

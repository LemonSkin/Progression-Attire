          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_StandardBase"]</xpath>
        <value>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[defName="DankPyon_Medieval_Bowman"]</xpath>
        <value>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>

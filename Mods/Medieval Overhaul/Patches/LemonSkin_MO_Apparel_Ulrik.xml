<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/label</xpath>
    <value>
      <label>chain coif (adorned)</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]/label</xpath>
    <value>
      <label>chainveil helm (adorned)</label>
    </value>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="DankPyon_Base_Pants"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedMailShirt"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22800</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <Insulation_Cold>15</Insulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <SocialImpact>0.05</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedWarriorArmor"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22800</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <Insulation_Cold>15</Insulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
            <PainShockThreshold>0.05</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>Torso</li>
              <li>Neck</li>
              <li>Shoulders</li>
              <li>Arms</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedHeavyPlate"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">150</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>32600</WorkToMake>
            <MaxHitPoints>290</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
            <Insulation_Cold>15</Insulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.7</MoveSpeed>
            <SocialImpact>0.10</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">50</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>14800</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.05</SocialImpact>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>7</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>19200</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.67</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.6</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-5</ShootingAccuracyPawn>
            <SocialImpact>0.05</SocialImpact>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>9</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_GreatHelm"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>27200</WorkToMake>
            <MaxHitPoints>160</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.81</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.8</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-7.0</ShootingAccuracyPawn>
            <MeleeHitChance>-0.5</MeleeHitChance>
            <SocialImpact>0.1</SocialImpact>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>11</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_AdornedArmorBase"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Adorned_HeavyMailCoif" or
          defName="DankPyon_Adorned_FlatTop" or
          defName="DankPyon_Adorned_GreatHelm"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- ######################################### END ########################################### -->
</Patch>

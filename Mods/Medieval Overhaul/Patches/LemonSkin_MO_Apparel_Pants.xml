<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="ProgressionAttire.PatchOperationMerge">
    <xpath>Defs/ThingDef[@Name="DankPyon_Base_Pants"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_Base_Pants"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1600</WorkToMake>
            <Mass>0.5</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.08</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <apparel>
            <tags Operation="AddOrReplace" />
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Apparel_Hose" or
          defName="DankPyon_Apparel_Trousers"
          ]
        </xpath>
        <value>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalBasic</li>
              <li>MedievalNoble</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Braies"]</xpath>
        <value>
          <apparel>
            <tags Operation="AddOrReplace" Inherit="False">
              <li>MedievalPeasant</li>
              <li>MedievalBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_Base_ArmoredPants"]</xpath>
        <value>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>OnSkin</li>
              <li>Middle</li>
            </layers>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_ChaussesPadded"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">40</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>2000</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.08</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_ChaussesSplinted"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">60</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>6000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>3</Mass>
            <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>2</Insulation_Cold>
            <Insulation_Heat>0.5</Insulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.05</MoveSpeed>
          </equippedStatOffsets>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryBasic</li>
            </tags>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_ChaussesPlate"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">80</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>8000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>3</Mass>
            <StuffEffectMultiplierArmor>0.45</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>2</Insulation_Cold>
            <Insulation_Heat>0.5</Insulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.1</MoveSpeed>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>8</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <tags Operation="AddOrReplace">
              <li>MedievalMilitaryAdvanced</li>
            </tags>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_Base_Pants"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_Base_ArmoredPants"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- ######################################### END ########################################### -->
</Patch>

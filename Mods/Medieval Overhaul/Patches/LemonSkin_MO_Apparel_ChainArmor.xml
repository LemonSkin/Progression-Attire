<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Hauberk -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Hauberk"]</xpath>
    <value>
      <ThingDef ParentName="ArmorSmithableBase">
        <defName>DankPyon_Apparel_Hauberk</defName>
        <label>hauberk</label>
        <description>A basic and simple hauberk. Offers decent and affordable protection against slashing and piercing attacks.</description>
        <graphicData>
          <texPath>Things/Pawn/Humanlike/Apparel/ChainArmor/Chain_Mail</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <recipeMaker>
          <recipeUsers>
            <li>ElectricSmithy</li>
            <li>FueledSmithy</li>
            <li>DankPyon_Anvil</li>
          </recipeUsers>
          <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
          <skillRequirements>
            <Crafting>6</Crafting>
          </skillRequirements>
          <researchPrerequisite>DankPyon_ChainArmor</researchPrerequisite>
        </recipeMaker>
        <stuffCategories>
          <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>60</costStuffCount>
        <statBases>
          <WorkToMake>10000</WorkToMake>
          <MaxHitPoints>150</MaxHitPoints>
          <Mass>2</Mass>
          <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
          <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
          <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
          <EquipDelay>4</EquipDelay>
        </statBases>
        <equippedStatOffsets>
          <MoveSpeed>-0.1</MoveSpeed>
        </equippedStatOffsets>
        <thingCategories>
          <li>LemonSkin_MedievalArmor</li>
        </thingCategories>
        <apparel>
          <bodyPartGroups>
            <li>Torso</li>
            <li>Neck</li>
            <li>Shoulders</li>
            <li>Arms</li>
          </bodyPartGroups>
          <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ChainArmor/Chain_Mail</wornGraphicPath>
          <tags>
            <li>DankPyon_BrigandRaider</li>
            <li>DankPyon_Mercenary</li>
            <li>DankPyon_MercenaryHeavy</li>
            <li>DankPyon_Archer</li>
            <li>DankPyon_Footman</li>
            <li>DankPyon_Billman</li>
            <li>DankPyon_Knight</li>
            <li>DankPyon_HedgeKnight</li>
            <li>MedievalMilitaryDecent</li>
            <li>MedievalMilitaryBasic</li>
          </tags>
          <layers>
            <li>Middle</li>
          </layers>
          <defaultOutfitTags>
            <li>Soldier</li>
          </defaultOutfitTags>
        </apparel>
      </ThingDef>
    </value>
  </Operation>



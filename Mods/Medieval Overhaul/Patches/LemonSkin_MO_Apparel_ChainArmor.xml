<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Hauberk"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">60</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>10000</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>4</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.1</MoveSpeed>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Heavy_Hauberk"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>15600</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="DankPyon_HeraldicHauberkBase"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>15600</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>8</Mass>
            <StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>6</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.2</MoveSpeed>
          </equippedStatOffsets>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="DankPyon_Apparel_Hauberk" or
          defName="DankPyon_Apparel_Heavy_Hauberk" or
          @Name="DankPyon_HeraldicHauberkBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

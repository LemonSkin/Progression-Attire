                <li>
                    <styleDef>PlateHelmet_KlappvisierHelmetClosed</styleDef>
                </li>
                <li>
                    <styleDef>PlateHelmet_KlappvisorBascinet</styleDef>
                </li>
                <li>
                    <styleDef>PlateHelmet_HounskullHelmet</styleDef>
                </li>
                <li>
                    <styleDef>PlateHelmet_SalletHelmet</styleDef>
                </li>
                <li>
                    <styleDef>PlateHelmet_SalletBellowFace</styleDef>
                </li>
                <li>
                    <styleDef>PlateHelmet_SalletGryphon</styleDef>
                </li>
            </randomStyle>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ReplaceLib.ReplacerDef[defName="ProgAttire_MedievalOverhaul"]/replacers</xpath>
        <value>
            <li>
                <replace>DankPyon_Headgear_Bascinet_KlappvisierHelmetClosed</replace>
                <with>DankPyon_Headgear_ClosedBascinetHelmet</with>
            </li>
            <li>
                <replace>DankPyon_Headgear_KlappvisorBascinet</replace>
                <with>DankPyon_Headgear_ClosedBascinetHelmet</with>
            </li>

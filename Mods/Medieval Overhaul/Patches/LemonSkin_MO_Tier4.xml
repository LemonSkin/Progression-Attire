<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- DankPyon_Apparel_FullPlate AKA Full Plate-->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate"]/costStuffCount</xpath>
        <value>
            <costStuffCount>170</costStuffCount>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate"]/statBases</xpath>
        <value>
            <statBases>
                <WorkToMake>38000</WorkToMake>
                <MaxHitPoints>290</MaxHitPoints>
                <Mass>15</Mass>
                <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
                <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
                <EquipDelay>15</EquipDelay>
            </statBases>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate"]/equippedStatOffsets</xpath>
        <value>
            <equippedStatOffsets>
                <MoveSpeed>-0.80</MoveSpeed>
                <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.15</SlaveSuppressionOffset>
            </equippedStatOffsets>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlate"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>LemonSkin_MedievalArmor</li>
            </thingCategories>
        </value>
    </Operation>


    <!-- DankPyon_Apparel_FullPlateGilded AKA Gilded Full Plate -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/recipeMaker/skillRequirements/Crafting</xpath>
        <value>
            <Crafting>14</Crafting>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/costStuffCount</xpath>
        <value>
            <costStuffCount>170</costStuffCount>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/costList</xpath>
        <value>
            <costList>
                <Gold>10</Gold>
            </costList>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/statBases</xpath>
        <value>
            <statBases>
                <WorkToMake>45000</WorkToMake>
                <MaxHitPoints>290</MaxHitPoints>
                <Mass>15</Mass>
                <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
                <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
                <EquipDelay>15</EquipDelay>
            </statBases>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/equippedStatOffsets</xpath>
        <value>
            <equippedStatOffsets>
                <MoveSpeed>-0.80</MoveSpeed>
                <SocialImpact>0.20</SocialImpact>
                <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.25</SlaveSuppressionOffset>
            </equippedStatOffsets>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/apparel/layers</xpath>
        <value>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisites>
                <li>PlateArmor</li>
                <li MayRequire="Ludeon.RimWorld.Royalty">RoyalApparel</li>
            </researchPrerequisites>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_FullPlateGilded"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>LemonSkin_MedievalArmor</li>
            </thingCategories>
        </value>
    </Operation>
</Patch>
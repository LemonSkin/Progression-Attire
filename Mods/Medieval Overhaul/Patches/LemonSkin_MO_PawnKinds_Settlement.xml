<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementPeasant"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Apparel_Braies</li>
          </apparelRequired>
          <specificApparelRequirements Operation="AddOrReplace" />
          <apparelMoney Operation="AddOrReplace">300~500</apparelMoney>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalPeasant</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementGuard"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace" />
          <specificApparelRequirements Operation="AddOrReplace" />
          <apparelMoney Operation="AddOrReplace">500~700</apparelMoney>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>
      </Operation>


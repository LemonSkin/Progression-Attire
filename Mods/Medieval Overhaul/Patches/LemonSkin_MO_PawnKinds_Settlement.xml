<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementPawnBase"]</xpath>
        <value>
          <specificApparelRequirements Operation="AddOrReplace" />
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementPeasant"]</xpath>
        <value>
          <itemQuality>Normal</itemQuality>
          <apparelAllowHeadgearChance>0.4</apparelAllowHeadgearChance>
          <apparelRequired Operation="AddOrReplace">
            <!-- <li>DankPyon_Apparel_Braies</li> -->
          </apparelRequired>
          <specificApparelRequirements Operation="AddOrReplace" />
          <apparelMoney Operation="AddOrReplace">300~500</apparelMoney>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalPeasant</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementGuard"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace" />
          <specificApparelRequirements Operation="AddOrReplace" />
          <apparelMoney Operation="AddOrReplace">500~700</apparelMoney>
          <apparelTags Operation="AddOrReplace">
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
          </apparelTags>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementArcher"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Headgear_ChainCoif</li>

            <li>DankPyon_Handwear_GlovesLeather</li>
            <li>DankPyon_Footwear_BootsLeather</li>

            <li>DankPyon_Apparel_Quiver</li>
          </apparelRequired>
          <specificApparelRequirements Operation="AddOrReplace">
            <li>
              <apparelLayer>Overhead</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Hands</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Leather_Plain</stuff>
            </li>
            <li>
              <bodyPartGroup>Feet</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Leather_Plain</stuff>
            </li>
          </specificApparelRequirements>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementFootman"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Headgear_ChainNasalHelmet</li>
            <li>DankPyon_Handwear_GlovesSplinted</li>
            <li>DankPyon_Footwear_BootsSplinted</li>
          </apparelRequired>
          <specificApparelRequirements Operation="AddOrReplace">
            <li>
              <apparelLayer>Overhead</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Hands</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Feet</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
          </specificApparelRequirements>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementKnight"]</xpath>
        <value>
          <!-- <apparelMoney Operation="AddOrReplace">700~900</apparelMoney> -->
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Apparel_FullPlate</li>
            <li>DankPyon_Apparel_Braies</li>
            <li>DankPyon_Handwear_GlovesPlate</li>
            <li>DankPyon_Footwear_BootsPlate</li>
          </apparelRequired>
          <specificApparelRequirements Operation="AddOrReplace">
            <li>
              <bodyPartGroup>FullHead</bodyPartGroup>
              <apparelLayer>Overhead</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Torso</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Hands</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Feet</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <apparelLayer>VFEC_OuterShell</apparelLayer>
              <stuff>Steel</stuff>
            </li>
          </specificApparelRequirements>
        </value>
      </Operation>

      <!-- Bugged tag needs to be removed -->
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/PawnKindDef[
          defName="DankPyon_Amboisse_Knight" or
          defName="DankPyon_Soren_Knight" or
          defName="DankPyon_Oswin_Knight" or
          defName="DankPyon_Hesse_Knight"
          ]
        </xpath>
        <value>
          <specificApparelRequirements Operation="SafeRemove" />
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/PawnKindDef[@Name="DankPyon_SettlementLord"]</xpath>
        <value>
          <apparelRequired Operation="AddOrReplace">
            <li>DankPyon_Headgear_ZweihanderHelm</li>

            <li>DankPyon_Apparel_Zweihanders_Cuirass</li>
            <li>DankPyon_Apparel_ChaussesPlate</li>

            <li>DankPyon_Handwear_GlovesPlate</li>
            <li>DankPyon_Footwear_BootsPlate</li>
          </apparelRequired>
          <apparelDisallowTags>
            <li>Neolithic</li>
          </apparelDisallowTags>
          <specificApparelRequirements Operation="AddOrReplace">
            <li>
              <apparelLayer>Overhead</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Torso</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Legs</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Hands</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
            <li>
              <bodyPartGroup>Feet</bodyPartGroup>
              <apparelLayer>Middle</apparelLayer>
              <stuff>Steel</stuff>
            </li>
          </specificApparelRequirements>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

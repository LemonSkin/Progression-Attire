        <xpath>Defs/ThingDef[defName="DankPyon_Headgear_ClosedBascinetHelmet"]/statBases</xpath>
        <value>
            <statBases>
                <WorkToMake>16000</WorkToMake>
                <MaxHitPoints>200</MaxHitPoints>
                <Mass>3.5</Mass>
                <StuffEffectMultiplierArmor>0.65</StuffEffectMultiplierArmor>

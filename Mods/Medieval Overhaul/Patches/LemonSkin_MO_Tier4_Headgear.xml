            </li>
            <li>
                <replace>DankPyon_Headgear_SalletBellowFace</replace>
                <with>DankPyon_Headgear_ClosedBascinetHelmet</with>
            </li>
            <li>
                <replace>DankPyon_Headgear_SalletGryphon</replace>
                <with>DankPyon_Headgear_ClosedBascinetHelmet</with>
            </li>
        </value>
    </Operation>



    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedMailShirt"]/costList</xpath>
        <value>
            <costList>
                <DankPyon_Linen>50</DankPyon_Linen>

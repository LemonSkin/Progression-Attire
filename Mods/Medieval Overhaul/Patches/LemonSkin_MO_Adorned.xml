    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[@Name="DankPyon_AdornedArmorBase"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>LemonSkin_MedievalArmor</li>
            </thingCategories>
        </value>
    </Operation>



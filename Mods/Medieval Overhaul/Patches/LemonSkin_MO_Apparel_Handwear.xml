<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesLeather"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>1000</WorkToMake>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>0.15</Mass>
            <StuffEffectMultiplierArmor>0.18</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.08</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesSplinted"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>4000</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>1</Mass>
            <StuffEffectMultiplierArmor>0.378</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <WorkSpeedGlobal>-0.05</WorkSpeedGlobal>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">5</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsPlate"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>6000</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>2.5</Mass>
            <StuffEffectMultiplierArmor>0.438</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">7</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesPlate"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>6000</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.438</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <WorkSpeedGlobal>-0.1</WorkSpeedGlobal>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">7</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesLeather"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="DankPyon_Handwear_GlovesSplinted" or
          defName="DankPyon_Handwear_GlovesPlate"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

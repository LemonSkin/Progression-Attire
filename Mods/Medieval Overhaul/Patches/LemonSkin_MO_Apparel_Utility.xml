<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Quiver"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Quiver"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>2500</WorkToMake>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>1</Mass>
            <EquipDelay>1</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <RangedCooldownFactor>-0.05</RangedCooldownFactor>
          </equippedStatOffsets>
          <apparel Operation="Safe">
            <bodyPartGroups Operation="AddOrReplace">
              <li>Waist</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="DankPyon_Apparel_Quiver" or
          defName="DankPyon_Apparel_FlashPotBelt" or
          defName="DankPyon_Apparel_FirePotBelt" or
          defName="DankPyon_Apparel_SmokePotBelt" or
          defName="DankPyon_Apparel_AcidFlaskBelt"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="DankPyon_ShieldHeater"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">DankPyon_ChainArmor</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="DankPyon_ShieldKite"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">PlateArmor</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[@Name="DankPyon_BaseShield"]</xpath>
        <value>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-2</ShootingAccuracyPawn>
            <MeleeHitChance>-2</MeleeHitChance>
            <MeleeDodgeChance>-5</MeleeDodgeChance>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_Shield"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>2600</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>2.5</Mass>
            <StuffEffectMultiplierArmor>0.34</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
            <Flammability>1.0</Flammability>
          </statBases>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">4</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_ShieldHeater"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">100</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>8000</WorkToMake>
            <MaxHitPoints>180</MaxHitPoints>
            <Mass>4</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
            <Flammability>1.0</Flammability>
          </statBases>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">6</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[@Name="DankPyon_ShieldHeaterBase"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>8000</WorkToMake>
            <MaxHitPoints>180</MaxHitPoints>
            <Mass>4</Mass>
            <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
            <Flammability>1.0</Flammability>
          </statBases>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DankPyon_ShieldKite"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">120</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>12000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>6</Mass>
            <StuffEffectMultiplierArmor>0.44</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
            <Flammability>1.0</Flammability>
          </statBases>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">8</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[@Name="DankPyon_BaseShield"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalShields</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

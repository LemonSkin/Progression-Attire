<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- DankPyon_Adorned_HeavyMailCoif -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/label</xpath>
        <value>
            <label>adorned chain coif</label>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/description</xpath>
        <value>
            <description>A thick hood forged from chains of metal and padded with linen for warmth. It provides excellent protection to the head against slashing and thrusting attacks.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/recipeMaker/skillRequirements/Crafting</xpath>
        <value>
            <Crafting>8</Crafting>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/statBases</xpath>
        <value>
            <statBases>
                <WorkToMake>12000</WorkToMake>
                <MaxHitPoints>150</MaxHitPoints>
                <Mass>2</Mass>
                <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
                <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
                <Insulation_Cold>5</Insulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
                <EquipDelay>3</EquipDelay>
            </statBases>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
        <value>
            <equippedStatOffsets>
                <PainShockThreshold>0.025</PainShockThreshold>
                <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
            </equippedStatOffsets>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/apparel/bodyPartGroups</xpath>
        <value>
            <bodyPartGroups>
                <li>UpperHead</li>
            </bodyPartGroups>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
        <value>
            <thingCategories Inherit="False">
                <li>LemonSkin_MedievalArmorHeadgear</li>
            </thingCategories>
        </value>
    </Operation>



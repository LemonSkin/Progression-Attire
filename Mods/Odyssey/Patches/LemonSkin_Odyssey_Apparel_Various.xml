<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Apparel_Vacsuit"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_VacsuitChildren"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_VacsuitChildren"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>LemonSkin_KidArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

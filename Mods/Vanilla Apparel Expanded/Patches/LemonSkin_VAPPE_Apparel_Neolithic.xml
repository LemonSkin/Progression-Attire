<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VAPPE_PeltCoat"]</xpath>
    <match Class="ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_PeltCoat"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_VAPPE_PeltCoat</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_PeltCoat"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>160</MaxHitPoints>
            <WorkToMake>10000</WorkToMake>
            <Mass>3</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.9</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_TribalPoncho"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.3</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>Torso</li>
              <li>Shoulders</li>
              <li>Neck</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_TribalKilt"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.3</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="VAE_Apparel_PeltCoat" or
          defName="VAE_Apparel_TribalPoncho" or
          defName="VAE_Apparel_TribalKilt"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

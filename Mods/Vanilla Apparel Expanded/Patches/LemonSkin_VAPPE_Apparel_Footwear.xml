<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="VAE_Footwear_Boots"]</xpath>
    <value>
      <techLevel Operation="AddOrReplace">Industrial</techLevel>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="VAE_Footwear_Shoes"]</xpath>
    <value>
      <techLevel Operation="AddOrReplace">Medieval</techLevel>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_RusticClothing</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VAE_Footwear_Shoes"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1600</WorkToMake>
            <Mass>0.25</Mass>
            <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.08</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.0</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VAE_Footwear_Boots"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_IndustrialApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VAE_Footwear_Shoes"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

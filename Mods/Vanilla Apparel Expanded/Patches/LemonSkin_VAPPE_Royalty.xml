<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="NobleApparel"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="ProgressionAttire.PatchOperationMerge">
          <xpath>
            Defs/ThingDef[
            defName="VAE_Apparel_Skirt" or
            defName="VAE_Apparel_ShirtandTie" or
            defName="VAE_Apparel_SuitJacket" or
            defName="VAE_Apparel_Trousers" or
            defName="VAE_Headgear_Fedora"
            ]
          </xpath>
          <value>
            <recipeMaker>
              <researchPrerequisite Operation="SafeRemove" />
              <researchPrerequisites Operation="AddOrReplace">
                <li>NobleApparel</li>
                <li>ComplexClothing</li>
              </researchPrerequisites>
            </recipeMaker>
          </value>
        </li>

        <li Class="PatchOperationRemove">
          <xpath>Defs/ResearchProjectDef[defName="VAE_FormalWear"]</xpath>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]</xpath>
          <value>
            <label Operation="AddOrReplace">researcher's lab coat</label>
          </value>
        </li>

        <li Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="VAE_Apparel_LabCoat"]</xpath>
          <value>
            <label Operation="AddOrReplace">chemist's lab coat</label>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]</xpath>
    <match Class="ProgressionAttire.PatchOperationMerge">
      <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite Operation="AddOrReplace">VAE_SterileAttire</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->

  <!-- ######################################### END ########################################### -->
</Patch>

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.FindMod">
        <mods>
          <li>Royalty</li>
        </mods>
        <caseTrue>
          <Operation Class="XmlExtensions.HybridPatch">
            <xpath>Defs/ThingDef[defName="VGE_Apparel_Vacsuit_Prestige"]</xpath>
            <value>
              <thingCategories Operation="AddOrReplace" Inherit="False">
                <li>LemonSkin_SpacerArmor</li>
              </thingCategories>
            </value>
          </Operation>

          <Operation Class="XmlExtensions.HybridPatch">
            <xpath>Defs/ThingDef[defName="VGE_Apparel_VacsuitHelmet_Prestige"]</xpath>
            <value>
              <thingCategories Operation="AddOrReplace" Inherit="False">
                <li>LemonSkin_SpacerArmorHeadgear</li>
              </thingCategories>
            </value>
          </Operation>
        </caseTrue>
      </Operation>
    </caseTrue>
  </Operation>


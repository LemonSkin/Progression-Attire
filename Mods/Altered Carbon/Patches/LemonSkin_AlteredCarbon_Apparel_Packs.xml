      <!-- AC_Apparel_WingJump -->
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AC_Apparel_WingJump"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_UltraUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

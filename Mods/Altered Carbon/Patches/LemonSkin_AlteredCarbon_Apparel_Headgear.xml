<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <!-- AC_ApparelArmorHelmetChrysalisMakeableBase -->
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[@Name="AC_ApparelArmorHelmetChrysalisMakeableBase"]/thingCategories</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_UltraArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <!-- AC_EnviroSuitHelmet -->
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="AC_EnviroSuitHelmet"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_UltraArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

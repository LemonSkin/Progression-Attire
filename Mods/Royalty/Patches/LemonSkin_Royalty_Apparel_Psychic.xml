<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->

  <!-- ######################################### REBALANCES ######################################### -->

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="Apparel_PsyfocusHelmet" or
          defName="Apparel_EltexSkullcap"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="Apparel_PsyfocusShirt" or
          defName="Apparel_PsyfocusVest" or
          defName="Apparel_PsyfocusRobe"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_UltraApparel</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

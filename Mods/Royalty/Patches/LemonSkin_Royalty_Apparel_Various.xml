      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="ApparelArmorCataphractBase"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[@Name="ApparelArmorHelmetCataphractBase"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">

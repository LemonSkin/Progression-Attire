<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VAE_Headgear_Beret"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="Apparel_Beret"]</xpath>
      <value>
        <label Operation="AddOrReplace">ceremonial beret</label>
      </value>
    </match>
  </Operation>

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>
      Defs/ThingDef[defName="Apparel_Beret" or
      @Name="ApparelHatRoyalTier2" or
      @Name="ApparelVestRoyalTier5Base" or
      @Name="ApparelShirtRoyalTier2Base"
      ]
    </xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisites Operation="AddOrReplace">
          <li>NobleApparel</li>
          <li>ComplexClothing</li>
        </researchPrerequisites>
        <researchPrerequisite Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>
      Defs/ThingDef[defName="Apparel_Coronet" or
      defName="Apparel_Crown"]
    </xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisites Operation="AddOrReplace">
          <li>RoyalApparel</li>
          <li>Smithing</li>
        </researchPrerequisites>
        <researchPrerequisite Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="Apparel_RobeRoyal"]</xpath>
        <value>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.2</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="Apparel_HatLadies" or
          defName="Apparel_HatTop"]
        </xpath>
        <value>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.15</SocialImpact>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
          </equippedStatOffsets>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES ######################################### -->
</Patch>

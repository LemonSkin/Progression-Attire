<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DV_Apparel_GolemancerBag"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>3500</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <apparel>
            <layers Operation="AddOrReplace">
              <li>Belt</li>
            </layers>
            <wornGraphicData Operation="AddOrReplace">
              <renderUtilityAsPack>false</renderUtilityAsPack>
            </wornGraphicData>
          </apparel>
        </value>
      </Operation>

      <Operation Class="PatchOperationRemove">
        <xpath>Defs/ApparelLayerDef[defName="DV_ShellAttachment"]</xpath>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DV_Apparel_GolemancerBag"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

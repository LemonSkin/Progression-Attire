<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DV_Apparel_GolemancerBag"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>3500</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- DV_Apparel_GolemancerBag -->
  <!-- <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DV_Apparel_GolemancerBag"]/apparel/layers</xpath>
    <value>
      <layers>
        <li>Belt</li>
      </layers>
    </value>
  </Operation> -->

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DV_Apparel_GolemancerBag"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_MedievalUtility</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

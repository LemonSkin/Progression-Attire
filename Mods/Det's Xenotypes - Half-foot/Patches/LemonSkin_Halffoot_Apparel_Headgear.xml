<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="DV_Apparel_ServiceHeadset"]</xpath>
          <value>
            <apparel>
              <layers Operation="AddOrReplace">
                <li>DankPyon_InnerHelmet</li>
              </layers>
            </apparel>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="DV_Apparel_ServiceHeadset"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

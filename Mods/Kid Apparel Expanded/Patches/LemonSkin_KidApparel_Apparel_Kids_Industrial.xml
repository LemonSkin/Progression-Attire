<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationReplace">
        <xpath>
          Defs/ThingDef[defName="Apparel_KidFlakVest" or
          defName="Apparel_KidFlakPants" or
          defName="Apparel_KidFlakJacket" or
          @Name="Apparel_KidArmorPowerBase" or
          @Name="ApparelKidArmorCataphractBase" or
          @Name="Apparel_KidArmorReconBase"]/thingCategories
        </xpath>
        <value>
          <thingCategories>
            <li>LemonSkin_KidArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <!-- Apparel_KidEltexRobe -->
      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexRobe"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexRobe"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>LemonSkin_KidApparel</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexShirt"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexShirt"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>LemonSkin_KidApparel</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexVest"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexVest"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>LemonSkin_KidApparel</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_KidFlakVest" or
          defName="Apparel_KidFlakPants" or
          defName="Apparel_KidFlakJacket" or
          @Name="Apparel_KidArmorPowerBase" or
          @Name="ApparelKidArmorCataphractBase" or
          @Name="Apparel_KidArmorReconBase"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_KidArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>
          Defs/ThingDef[
          defName="Apparel_KidEltexRobe" or
          defName="Apparel_KidEltexShirt" or
          defName="Apparel_KidEltexVest"
          ]
        </xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>
            Defs/ThingDef[
            defName="Apparel_KidEltexRobe" or
            defName="Apparel_KidEltexShirt" or
            defName="Apparel_KidEltexVest"
            ]
          </xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_KidApparel</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

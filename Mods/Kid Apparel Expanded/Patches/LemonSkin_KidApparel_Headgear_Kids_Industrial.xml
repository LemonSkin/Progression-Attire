<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_AdvancedKidHelmet"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_KidArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="Apparel_KidPsychicFoil"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_KidHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexHelmet"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexHelmet"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_KidArmorHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexSkullcap"]</xpath>
        <match Class="ferny.ProgressionAttire.PatchOperationMerge">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexSkullcap"]</xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_KidHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

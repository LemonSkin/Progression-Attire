<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_AdvancedKidHelmet"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_KidArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_KidPsychicFoil"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_KidHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexHelmet"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexHelmet"]/thingCategories</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>LemonSkin_KidArmorHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Apparel_KidEltexSkullcap"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Apparel_KidEltexSkullcap"]/thingCategories</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>LemonSkin_KidHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

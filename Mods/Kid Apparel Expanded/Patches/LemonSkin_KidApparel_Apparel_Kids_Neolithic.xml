<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_KidWarMask"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_KidArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_KidVisageMask"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_KidHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

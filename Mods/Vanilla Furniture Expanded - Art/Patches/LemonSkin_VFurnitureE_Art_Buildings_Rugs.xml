<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="LemonSkin_MO_Rugs"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name="RugBase"]/recipeMaker/researchPrerequisite</xpath>
          <value>
            <researchPrerequisite>LemonSkin_MO_Rugs</researchPrerequisite>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ResearchProjectDef[defName="VFE_Res_Rugs"]</xpath>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalHeavy"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_VFET_HeavyTribalwear</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.HybridPatch">
    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]</xpath>
    <value>
      <recipeMaker Operation="Safe">
        <researchPrerequisite Operation="AddOrReplace">LemonSkin_VFET_WarTribalwear</researchPrerequisite>
        <researchPrerequisites Operation="SafeRemove" />
      </recipeMaker>
    </value>
  </Operation>

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalLight"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.4</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalHeavy"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.6</Mass>
            <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.85</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>120</MaxHitPoints>
            <WorkToMake>2200</WorkToMake>
            <Mass>2.6</Mass>
            <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
            <ArmorRating_Heat>0.15</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>0</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="VFET_Apparel_TribalLight" or
          defName="VFET_Apparel_TribalHeavy"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ######################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VARME_WoodenArmor"]</xpath>
    <match Class="XmlExtensions.HybridPatch">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]</xpath>
      <value>
        <recipeMaker Operation="Safe">
          <researchPrerequisite Operation="AddOrReplace">LemonSkin_VARME_WoodenArmor</researchPrerequisite>
          <researchPrerequisites Operation="SafeRemove" />
        </recipeMaker>
      </value>
    </match>
  </Operation>
  <!-- ######################################### REBALANCES ######################################### -->

  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VAE_Headgear_StoneWarMask"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

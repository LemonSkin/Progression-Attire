<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Hauberk"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_Chainmail"]/label</xpath>
      <value>
        <label>light hauberk</label>
      </value>
    </match>
  </Operation>

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_LightPlateArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">150</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>230</MaxHitPoints>
            <Mass>12</Mass>
            <StuffEffectMultiplierArmor>0.67</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.4</MoveSpeed>
          </equippedStatOffsets>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_PlateShoulderpads"]</xpath>
        <value>
          <statBases Operation="AddOrReplace">
            <WorkToMake>7200</WorkToMake>
            <MaxHitPoints>250</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.78</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2</EquipDelay>
          </statBases>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>9</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_Chainmail"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">50</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>10000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.46</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.05</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.05</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>4</EquipDelay>
          </statBases>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>6</Crafting>
            </skillRequirements>
          </recipeMaker>
          <apparel>
            <bodyPartGroups Operation="AddOrReplace">
              <li>Torso</li>
              <li>Shoulders</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_PlateHelmet"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">70</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>14600</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.72</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <ShootingAccuracyPawn>-6</ShootingAccuracyPawn>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>7</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ferny.ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="VAE_Apparel_Gambeson" or
          defName="VAE_Apparel_QuiltedVest"
          ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>
          Defs/ThingDef[
          defName="VAE_Apparel_LightPlateArmor" or
        defName="VAE_Apparel_PlateShoulderpads" or
        defName="VAE_Apparel_Chestplate" or
        defName="VAE_Apparel_Chainmail"
        ]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ferny.ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_PlateHelmet"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmorHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### MO DE-DUPE ######################################### -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Dankpyon_Apparel_Gambeson"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_Gambeson"]</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Leather_Tunic"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_QuiltedVest"]</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_Breast_Plate"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_Chestplate"]</xpath>
    </match>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

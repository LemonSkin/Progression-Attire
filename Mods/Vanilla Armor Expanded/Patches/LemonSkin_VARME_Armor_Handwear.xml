<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyRebalances</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">35</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>6000</WorkToMake>
            <MaxHitPoints>140</MaxHitPoints>
            <Mass>2</Mass>
            <StuffEffectMultiplierArmor>0.438</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <WorkSpeedGlobal>-0.1</WorkSpeedGlobal>
          </equippedStatOffsets>
          <recipeMaker>
            <skillRequirements Operation="AddOrReplace">
              <Crafting>7</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_MedievalArmor</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="ProgressionAttire.PatchOperationMerge">
        <xpath>Defs/ThingDef[defName="VAE_Handwear_MarineGloves"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_SpacerArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### MO DE-DUPE #################################### -->

  <!-- <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesPlate"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves"]</xpath>
    </match>
  </Operation> -->

  <!-- ######################################### STYLES ######################################## -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>createStyles</settingName>
    <caseTrue>
      <Operation Class="ProgressionAttire.PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="DankPyon_Handwear_GlovesPlate"]</xpath>
        <caseTrue>
          <Operation Class="ProgressionAttire.PatchOperationMerge">
            <xpath>/Defs/ThingDef[defName="DankPyon_Handwear_GlovesPlate"]</xpath>
            <value>
              <randomStyleChance Operation="SafeAdd">0.5</randomStyleChance>
              <randomStyle>
                <li Operation="Add">
                  <styleDef>VAE_Handwear_PlateGloves</styleDef>
                </li>
              </randomStyle>
            </value>
          </Operation>

          <Operation Class="PatchOperationAdd">
            <xpath>Defs/ReplaceLib.ReplacerDef[defName="ProgressionAttire"]/replacers</xpath>
            <value>
              <li>
                <replace>VAE_Handwear_PlateGloves</replace>
                <with>DankPyon_Handwear_GlovesPlate</with>
              </li>
            </value>
          </Operation>
        </caseTrue>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################## -->

  <!-- ######################################### RESEARCH ###################################### -->

  <!-- ######################################### REBALANCES #################################### -->

  <!-- ######################################### CATEGORIES #################################### -->
  <Operation Class="ProgressionAttire.PatchOperationCheckSetting">
    <settingName>applyCategories</settingName>
    <caseTrue>
      <Operation Class="PatchOperationConditional">
        <xpath>
          Defs/ThingDef[
          defName="VAE_Headgear_RoyalTrooperHelmet" or
          defName="VAE_Headgear_RoyalSiegeHelmet"
          ]
        </xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>
            Defs/ThingDef[
            defName="VAE_Headgear_RoyalTrooperHelmet" or
            defName="VAE_Headgear_RoyalSiegeHelmet"
            ]
          </xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmorHeadgear</li>
            </thingCategories>
          </value>
        </match>
      </Operation>

      <Operation Class="PatchOperationConditional">
        <xpath>
          Defs/ThingDef[
          defName="VAE_Apparel_RoyalTrooperArmor" or
          defName="VAE_Apparel_RoyalSiegeArmor"
          ]
        </xpath>
        <match Class="ProgressionAttire.PatchOperationMerge">
          <xpath>
            Defs/ThingDef[
            defName="VAE_Apparel_RoyalTrooperArmor" or
            defName="VAE_Apparel_RoyalSiegeArmor"
            ]
          </xpath>
          <value>
            <thingCategories Operation="AddOrReplace" Inherit="False">
              <li>LemonSkin_SpacerArmor</li>
            </thingCategories>
          </value>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

  <!-- ######################################### END ########################################### -->
</Patch>

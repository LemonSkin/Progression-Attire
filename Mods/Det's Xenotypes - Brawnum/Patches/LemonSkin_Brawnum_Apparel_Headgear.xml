<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DV_Apparel_HaySunhat"]/recipeMaker</xpath>
    <value>
      <researchPrerequisite>LemonSkin_RusticClothing</researchPrerequisite>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="DV_Apparel_HaySunhat"]</xpath>
        <value>
          <costList Operation="AddOrReplace">
            <Hay>25</Hay>
          </costList>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>1800</WorkToMake>
            <Mass>0.07</Mass>
            <Flammability>1.5</Flammability>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.025</ArmorRating_Blunt>
            <ArmorRating_Heat>-0.1</ArmorRating_Heat>
            <Insulation_Cold>0</Insulation_Cold>
            <Insulation_Heat>8</Insulation_Heat>
            <EquipDelay>0.8</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="SafeRemove" />
        </value>
      </Operation>
    </caseTrue>
  </Operation>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DV_Apparel_HaySunhat"]</xpath>
        <value>
          <thingCategories Inherit="False">
            <li>LemonSkin_MedievalHeadgear</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>

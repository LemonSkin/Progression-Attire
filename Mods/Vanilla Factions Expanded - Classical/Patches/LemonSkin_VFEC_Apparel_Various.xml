<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- ######################################### LABELS ######################################### -->

  <!-- ######################################### RESEARCH ######################################### -->

  <!-- ######################################### REBALANCES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyRebalances</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFEC_Toga"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">50</costStuffCount>
          <statBases Operation="AddOrReplace">
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>2000</WorkToMake>
            <Mass>0.4</Mass>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.35</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.75</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <SocialImpact>0.1</SocialImpact>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="SafeRemove" />
          </recipeMaker>
          <apparel Operation="Safe">
            <bodyPartGroups Operation="AddOrReplace">
              <li>Torso</li>
              <li>Shoulders</li>
              <li>Legs</li>
            </bodyPartGroups>
          </apparel>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFEC_Apparel_LegionnaireArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">140</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>10</Mass>
            <StuffEffectMultiplierArmor>0.34</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>10</EquipDelay>
          </statBases>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">6</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFEC_Apparel_CenturionArmor"]</xpath>
        <value>
          <costStuffCount Operation="AddOrReplace">180</costStuffCount>
          <statBases Operation="AddOrReplace">
            <WorkToMake>22000</WorkToMake>
            <MaxHitPoints>230</MaxHitPoints>
            <Mass>15</Mass>
            <StuffEffectMultiplierArmor>0.45</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>15</EquipDelay>
          </statBases>
          <equippedStatOffsets Operation="AddOrReplace">
            <MoveSpeed>-0.4</MoveSpeed>
          </equippedStatOffsets>
          <recipeMaker Operation="Safe">
            <skillRequirements Operation="Safe">
              <Crafting Operation="AddOrReplace">8</Crafting>
            </skillRequirements>
          </recipeMaker>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
  <!-- ######################################### CATEGORIES ######################################### -->
  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>ferny.progressionattire</modId>
    <key>ApplyCategories</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>Defs/ThingDef[defName="VFEC_Toga"]</xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicApparel</li>
          </thingCategories>
        </value>
      </Operation>

      <Operation Class="XmlExtensions.HybridPatch">
        <xpath>
          Defs/ThingDef[defName="VFEC_Apparel_LegionnaireArmor" or
          defName="VFEC_Apparel_CenturionArmor"]
        </xpath>
        <value>
          <thingCategories Operation="AddOrReplace" Inherit="False">
            <li>LemonSkin_NeolithicArmor</li>
          </thingCategories>
        </value>
      </Operation>
    </caseTrue>
  </Operation>
</Patch>
